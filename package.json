{
  "name": "ledge-obsidian-plugin",
  "version": "2.0.0",
  "description": "A configurable context-aware edge dock for Obsidian workspaces.",
  "main": "main.js",
  "private": true,
  "type": "module",
  "keywords": [
    "obsidian",
    "dock",
    "navigation",
    "workspace"
  ],
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint:code": "eslint .",
    "lint:css": "stylelint styles.css",
    "lint": "npm run lint:code && npm run lint:css",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run test && npm run build && node --check main.js",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.6.1",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "stylelint": "^17.14.1",
    "stylelint-config-obsidianmd": "^0.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22"
  }
}
